<%# locals: (attachment:, owner_transaction:, entry:, can_upload:, can_delete:, from_parent:) %>
<div class="flex items-center justify-between p-3 border border-primary rounded-lg bg-container">
  <div class="flex items-center gap-3">
    <div class="flex-shrink-0">
      <% if attachment.image? %>
        <%= icon "image", size: "sm", color: "secondary" %>
      <% else %>
        <%= icon "file", size: "sm", color: "secondary" %>
      <% end %>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-medium text-primary truncate"><%= attachment.filename %></p>
      <p class="text-xs text-secondary"><%= number_to_human_size(attachment.byte_size) %></p>
    </div>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to attachment_preview_tax_documents_path(attachment_id: attachment.id),
          class: "inline-flex items-center justify-center p-2 rounded-md border border-primary text-primary hover:bg-surface-hover",
          title: t("tax.documents_all.view"),
          aria: { label: t("tax.documents_all.view") },
          data: { turbo_frame: "document_viewer" } do %>
      <%= icon("eye", size: "sm") %>
    <% end %>

    <%= render DS::Link.new(
          href: transaction_attachment_path(owner_transaction, attachment, disposition: :attachment),
          variant: :outline,
          size: :sm,
          icon: "download",
          text: "",
          title: t("tax.documents_all.download"),
          data: { turbo: false }
        ) %>

    <% if can_delete %>
      <%= render DS::Button.new(
            href: transaction_attachment_path(owner_transaction, attachment),
            method: :delete,
            variant: :outline_destructive,
            size: :sm,
            icon: "trash-2",
            confirm: CustomConfirm.for_resource_deletion("attachment")
          ) %>
    <% end %>
    <% if entry && can_upload && !from_parent && Tax::DocumentLinker.standalone_origin?(attachment) %>
      <%= button_to tax_entry_attachment_restore_path(entry_id: entry.id),
            params: { attachment_id: attachment.id },
            method: :post,
            form: { data: { turbo_stream: true } },
            class: "inline-flex items-center justify-center p-2 rounded-md border border-primary text-primary hover:bg-surface-hover",
            title: t("tax.documents_all.restore_standalone"),
            aria: { label: t("tax.documents_all.restore_standalone") } do %>
        <%= icon("unlink", size: "sm") %>
      <% end %>
    <% end %>
  </div>
</div>
