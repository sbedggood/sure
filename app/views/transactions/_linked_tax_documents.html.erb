<%# locals: (entry:, can_manage:) %>
<% tax_documents = entry.tax_documents.includes(file_attachment: :blob) %>
<% return if tax_documents.empty? %>

<div class="space-y-2 mb-4">
  <h4 class="text-sm font-medium text-primary"><%= t(".linked_tax_documents_heading") %></h4>
  <div class="space-y-2">
    <% tax_documents.each do |document| %>
      <% next unless document.file.attached? %>
      <div class="flex items-center justify-between p-3 border border-primary rounded-lg bg-container gap-3">
        <div class="flex items-center gap-3 min-w-0">
          <div class="flex-shrink-0">
            <% if document.file.image? %>
              <%= icon "image", size: "sm", color: "secondary" %>
            <% else %>
              <%= icon "file", size: "sm", color: "secondary" %>
            <% end %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-primary truncate"><%= document.file.filename %></p>
            <p class="text-xs text-secondary">
              <%= document.document_type %>
              <% if document.document_date %>
                · <%= l(document.document_date) %>
              <% end %>
            </p>
          </div>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <%= link_to preview_tax_document_path(document),
                class: "inline-flex items-center justify-center p-2 rounded-md border border-primary text-primary hover:bg-surface-hover",
                title: t("tax.documents_all.view"),
                aria: { label: t("tax.documents_all.view") },
                data: { turbo_frame: "document_viewer" } do %>
            <%= icon("eye", size: "sm") %>
          <% end %>
          <%= link_to download_tax_document_path(document),
                class: "inline-flex items-center justify-center p-2 rounded-md border border-primary text-primary hover:bg-surface-hover",
                title: t("tax.documents_all.download"),
                aria: { label: t("tax.documents_all.download") },
                data: { turbo: false } do %>
            <%= icon("download", size: "sm") %>
          <% end %>
          <% if can_manage %>
            <%= button_to tax_document_link_destroy_path(tax_document_id: document.id),
                  method: :delete,
                  form: { data: { turbo_stream: true } },
                  class: "inline-flex items-center justify-center p-2 rounded-md border border-primary text-primary hover:bg-surface-hover",
                  title: t("tax.documents_all.unlink_from_transaction"),
                  aria: { label: t("tax.documents_all.unlink_from_transaction") } do %>
              <%= icon("unlink", size: "sm") %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
