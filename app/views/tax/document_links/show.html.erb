<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(custom_header: true) do %>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 id="<%= dialog.title_id %>" class="text-lg font-medium text-primary truncate"><%= @document.file.filename %></h2>
        <p class="text-sm text-secondary"><%= @document.document_type %> · <%= Tax::FinancialYear.new(@document.start_year).label %></p>
      </div>
      <%= render DS::Button.new(variant: "icon", size: :sm, icon: "x", data: { action: "DS--dialog#close" }, aria_label: t("ds.dialog.close")) %>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <div class="space-y-4">
      <% if @document.entry %>
        <div class="bg-container-inset rounded-lg p-3 flex items-center justify-between gap-3">
          <div class="min-w-0">
            <p class="text-sm font-medium text-primary truncate"><%= @document.entry.name %></p>
            <p class="text-xs text-secondary"><%= l(@document.entry.date) %> · <%= @document.entry.account.name %></p>
          </div>
          <%= button_to t("tax.documents.unlinked"),
                tax_document_link_destroy_path(tax_document_id: @document.id),
                method: :delete,
                class: "text-sm text-destructive shrink-0" %>
        </div>
      <% else %>
        <p class="text-sm text-secondary"><%= t("tax.documents.link_prompt") %></p>
      <% end %>

      <div class="space-y-3">
        <p class="text-xs font-medium text-secondary uppercase"><%= t("recurring_occurrences.show.find_heading") %></p>

        <%= styled_form_with url: tax_document_link_path(tax_document_id: @document.id),
              method: :get,
              data: { controller: "auto-submit-form", turbo_frame: "document_link_search" },
              class: "space-y-3" do |form| %>
          <%= render DS::SearchInput.new(
                name: "q",
                value: @candidate_query,
                placeholder: t("tax.property.search_placeholder_extended"),
                aria_label: t("tax.property.search_placeholder_extended"),
                class: "w-full",
                data: {
                  "auto-submit-form-target": "auto",
                  autosubmit_trigger_event: "input",
                  autosubmit_debounce_timeout: 400
                }
              ) %>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= render DS::Select.new(
                  form: form,
                  method: :fy,
                  items: [ { label: t("tax.property.fy_all"), value: "all" } ] +
                    @fy_options.map { |label, year| { label: label, value: year.to_s } },
                  selected: @fy_filter,
                  label: t("tax.fy_label"),
                  html_options: { data: { "auto-submit-form-target": "auto" } }
                ) %>
            <%= render DS::Select.new(
                  form: form,
                  method: :account_id,
                  items: @account_options.map { |account| { label: account.name, value: account.id } },
                  selected: @account_id.presence,
                  include_blank: t("tax.property.all_accounts"),
                  label: t("tax.property.account_filter"),
                  html_options: { data: { "auto-submit-form-target": "auto" } }
                ) %>
          </div>
        <% end %>

        <%= render "tax/document_links/search_results",
              search_results: @search_results,
              document: @document,
              candidate_query: @candidate_query,
              fy_filter: @fy_filter,
              account_id: @account_id %>
      </div>
    </div>
  <% end %>
<% end %>
