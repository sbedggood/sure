<% label = @tag_name.sub("Tax: Property - ", "").presence || @tag_name %>
<% cell_total = @entries.sum { |e| e.amount.abs } %>

<%= render DS::Dialog.new(frame: "drawer", responsive: true) do |dialog| %>
  <% dialog.with_header(custom_header: true) do %>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 id="<%= dialog.title_id %>" class="text-lg font-medium text-primary truncate"><%= label %></h2>
        <p class="text-sm text-secondary"><%= l(@month, format: :long) %> · <%= @financial_year.label %></p>
      </div>
      <%= render DS::Button.new(
            variant: "icon",
            size: :sm,
            icon: "x",
            class: "ml-auto shrink-0",
            title: t("ds.dialog.close"),
            aria_label: t("ds.dialog.close"),
            data: { action: "DS--dialog#close" }
          ) %>
    </div>
  <% end %>

  <% dialog.with_body do %>
    <div class="space-y-4">
      <div class="flex items-center gap-4">
        <div class="min-w-0 space-y-0.5">
          <p class="text-2xl font-medium text-primary privacy-sensitive"><%= number_to_currency(cell_total) %></p>
          <p class="text-sm text-secondary"><%= t("tax.property.cell_linked", count: @entries.size) %></p>
        </div>
      </div>

      <% if @entries.any? %>
        <div class="space-y-1">
          <p class="text-xs font-medium text-secondary uppercase"><%= t("tax.property.linked_transactions") %></p>
          <div class="bg-container-inset rounded-lg divide-y divide-subdued">
            <% @entries.each do |entry| %>
              <div class="flex items-center justify-between gap-3 px-3 py-2">
                <div class="min-w-0">
                  <p class="text-sm text-primary truncate"><%= entry.name %></p>
                  <p class="text-xs text-secondary">
                    <%= l(entry.date, format: :short_with_year) %>
                    <% if entry.account %> &middot; <%= entry.account.name %><% end %>
                  </p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-sm text-primary privacy-sensitive"><%= format_money(entry.amount_money.abs) %></span>
                  <%= button_to t("tax.property.unlink"),
                    tax_property_cell_unlink_path,
                    method: :delete,
                    params: {
                      entry_id: entry.id,
                      tag_name: @tag_name,
                      month: @month.iso8601,
                      start_year: @financial_year.start_year,
                      fy: @fy_filter,
                      q: @candidate_query,
                      account_id: @account_id
                    },
                    class: "text-xs text-destructive shrink-0" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="space-y-3">
        <p class="text-xs font-medium text-secondary uppercase"><%= t("recurring_occurrences.show.find_heading") %></p>

        <%= styled_form_with url: tax_property_cell_path(tag_name: @tag_name, month: @month.iso8601, start_year: @financial_year.start_year),
              method: :get,
              data: { controller: "auto-submit-form", turbo_frame: "property_cell_search" },
              class: "space-y-3" do |form| %>
          <%= render DS::SearchInput.new(
                name: "q",
                value: @candidate_query,
                placeholder: t("tax.property.search_placeholder_extended"),
                aria_label: t("tax.property.search_placeholder_extended"),
                class: "w-full",
                data: {
                  "auto-submit-form-target": "auto",
                  autosubmit_trigger_event: "input",
                  autosubmit_debounce_timeout: 400
                }
              ) %>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <%= render DS::Select.new(
                  form: form,
                  method: :fy,
                  items: [ { label: t("tax.property.fy_all"), value: "all" } ] +
                    @fy_options.map { |label, year| { label: label, value: year.to_s } },
                  selected: @fy_filter,
                  label: t("tax.fy_label"),
                  html_options: { data: { "auto-submit-form-target": "auto" } }
                ) %>
            <%= render DS::Select.new(
                  form: form,
                  method: :account_id,
                  items: @account_options.map { |account| { label: account.name, value: account.id } },
                  selected: @account_id.presence,
                  include_blank: t("tax.property.all_accounts"),
                  label: t("tax.property.account_filter"),
                  html_options: { data: { "auto-submit-form-target": "auto" } }
                ) %>
          </div>
        <% end %>

        <%= render "tax/property_cells/search_results",
              search_results: @search_results,
              tag_name: @tag_name,
              month: @month,
              financial_year: @financial_year,
              candidate_query: @candidate_query,
              fy_filter: @fy_filter,
              account_id: @account_id %>
      </div>

      <% if @suggested_entries.any? %>
        <div class="space-y-2 pt-1 border-t border-subdued">
          <p class="text-xs font-medium text-secondary uppercase"><%= t("tax.property.suggested_heading") %></p>
          <div class="bg-container-inset rounded-lg divide-y divide-subdued">
            <% @suggested_entries.each do |entry| %>
              <%= render "tax/property_cells/candidate",
                    entry: entry,
                    tag_name: @tag_name,
                    month: @month,
                    financial_year: @financial_year,
                    fy_filter: @fy_filter,
                    candidate_query: @candidate_query,
                    account_id: @account_id %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
