<%# locals: (entry:, tag_name:, month:, financial_year:, fy_filter:, candidate_query:, account_id:) %>
<% amount = format_money(entry.amount_money.abs) %>

<div class="flex items-center justify-between gap-3 px-3 py-2">
  <div class="min-w-0">
    <p class="text-sm text-primary truncate"><%= entry.name %></p>
    <p class="text-xs text-secondary truncate">
      <%= l(entry.date, format: :short_with_year) %>
      <% if entry.account %> &middot; <%= entry.account.name %><% end %>
    </p>
  </div>
  <div class="flex items-center gap-2 shrink-0">
    <span class="text-sm text-primary privacy-sensitive"><%= amount %></span>
    <%= button_to t("tax.property.link"),
          tax_property_cell_link_path,
          params: {
            entry_id: entry.id,
            tag_name: tag_name,
            month: month.iso8601,
            start_year: financial_year.start_year,
            fy: fy_filter,
            q: candidate_query,
            account_id: account_id
          },
          class: "text-xs font-medium text-accent" %>
  </div>
</div>
