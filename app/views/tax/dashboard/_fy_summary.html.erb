<%# locals: (summary:, deductions:) %>
<% deductions_data = summary.as_json[:deductions] %>
<% property = summary.as_json[:property] %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
  <div class="bg-container-inset rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <%= icon("receipt", size: "sm") %>
      <span class="text-sm text-secondary"><%= t("tax.summary.deductions_claim") %></span>
    </div>
    <p class="text-xl font-semibold text-primary privacy-sensitive">
      <%= number_to_currency(deductions.claimable_grand_total) %>
    </p>
  </div>

  <div class="bg-container-inset rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <%= icon("home", size: "sm") %>
      <span class="text-sm text-secondary"><%= t("tax.summary.rental_income") %></span>
    </div>
    <p class="text-xl font-semibold text-primary privacy-sensitive">
      <%= number_to_currency(property[:rental_income][:total]) %>
    </p>
  </div>

  <div class="bg-container-inset rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <%= icon("scale", size: "sm") %>
      <span class="text-sm text-secondary"><%= t("tax.summary.property_net") %></span>
    </div>
    <p class="text-xl font-semibold text-primary privacy-sensitive">
      <%= number_to_currency(property[:difference]) %>
    </p>
  </div>

  <div class="bg-container-inset rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <%= icon("percent", size: "sm") %>
      <span class="text-sm text-secondary"><%= t("tax.summary.expected_return") %></span>
    </div>
    <p class="text-xl font-semibold text-primary privacy-sensitive">
      <%= number_to_currency(property[:expected_return]) %>
    </p>
  </div>

  <div class="bg-container-inset rounded-lg p-4">
    <div class="flex items-center gap-2 mb-3">
      <%= icon("clock", size: "sm") %>
      <span class="text-sm text-secondary"><%= t("tax.summary.pending_review") %></span>
    </div>
    <p class="text-xl font-semibold text-primary privacy-sensitive">
      <%= number_to_currency(deductions.pending_for_review_total.abs) %>
    </p>
  </div>
</div>
