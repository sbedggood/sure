<%# locals: (entry:) %>
<% attachments = entry.transaction.attachments %>
<% return unless attachments.attached? %>

<div class="absolute right-32 top-4 z-10 hidden lg:block">
  <% if attachments.one? %>
    <%= link_to rails_blob_path(attachments.first, disposition: "inline"),
          target: "_blank",
          rel: "noopener",
          class: "text-secondary hover:text-primary",
          title: t("tax.deductions.has_attachments") do %>
      <%= icon("paperclip", size: "sm") %>
    <% end %>
  <% else %>
    <%= render DS::Menu.new do |menu| %>
      <% attachments.each do |attachment| %>
        <% menu.with_item(
             variant: "link",
             text: attachment.filename.to_s,
             icon: "paperclip",
             href: rails_blob_path(attachment, disposition: "inline"),
             data: { turbo: false }
           ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
