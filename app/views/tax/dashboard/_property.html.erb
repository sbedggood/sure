<%# locals: (financial_year:, settings:, summary:, property_grid:) %>
<% property = summary.as_json[:property] %>
<% expense_rows = property[:expense_rows] %>
<% informational_rows = property[:informational_rows] || [] %>
<% month_keys = property_grid.months.map(&:iso8601) %>
<% monthly_expense_totals = month_keys.index_with do |key|
     expense_rows.sum { |row| BigDecimal((row[:months][key] || 0).to_s) }
   end %>

<%= render "tax/dashboard/property_stat_cards", property: property %>

<div class="bg-container rounded-xl shadow-border-xs p-4 mb-4 mt-4">
  <%= styled_form_with url: tax_settings_path, method: :patch, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :start_year, financial_year.start_year %>
    <%= hidden_field_tag :return_section, "property" %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= form.number_field "tax_fy_setting[property_allocation_percent]", label: t("tax.property.allocation"), value: settings.property_allocation_percent, step: 0.01 %>
      <%= form.number_field "tax_fy_setting[marginal_tax_rate_percent]", label: t("tax.property.marginal_rate"), value: settings.marginal_tax_rate_percent, step: 0.01 %>
    </div>
    <div class="flex justify-end">
      <%= render DS::Button.new(text: t("tax.property.save_settings"), variant: "primary", type: "submit") %>
    </div>
  <% end %>
</div>

<div class="rounded-xl bg-container-inset space-y-1 p-1">
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p><%= t("tax.property.expenses_title") %></p>
    <span class="text-subdued">&middot;</span>
    <p><%= financial_year.label %></p>
  </div>

  <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <th class="px-3 py-3 text-left min-w-44"><%= t("tax.property.line") %></th>
          <% property_grid.months.each do |month| %>
            <th class="px-3 py-3 text-right min-w-24"><%= l(month, format: "%b %y") %></th>
          <% end %>
          <th class="px-3 py-3 text-right min-w-24"><%= t("tax.property.total") %></th>
        </tr>
      </thead>
      <tbody>
        <% expense_rows.each do |row| %>
          <tr class="border-b border-subdued hover:bg-surface-hover">
            <td class="px-3 py-3 text-sm font-medium text-primary">
              <span><%= row[:label] %></span>
              <% if row[:capital_improvement] %>
                <p class="text-xs font-normal text-secondary mt-0.5"><%= t("tax.property.improvements_note") %></p>
              <% end %>
            </td>
            <% property_grid.months.each do |month| %>
              <% amount = row[:months][month.iso8601] || 0 %>
              <td class="px-3 py-3 text-sm text-right">
                <%= link_to(number_to_currency(amount),
                  tax_property_cell_path(
                    tag_name: row[:tag],
                    month: month.iso8601,
                    start_year: financial_year.start_year
                  ),
                  data: { turbo_frame: "drawer" },
                  class: "text-primary hover:underline privacy-sensitive") %>
              </td>
            <% end %>
            <td class="px-3 py-3 text-sm text-right font-medium text-primary privacy-sensitive"><%= number_to_currency(row[:total]) %></td>
          </tr>
        <% end %>
        <% informational_rows.each do |row| %>
          <tr class="border-b border-subdued bg-surface-inset/50 hover:bg-surface-hover">
            <td class="px-3 py-3 text-sm font-medium text-primary">
              <span><%= row[:label] %></span>
              <p class="text-xs font-normal text-secondary mt-0.5"><%= t("tax.property.tenant_bill_share_note") %></p>
            </td>
            <% property_grid.months.each do |month| %>
              <% amount = row[:months][month.iso8601] || 0 %>
              <td class="px-3 py-3 text-sm text-right">
                <%= link_to(amount.positive? ? number_to_currency(amount) : "—",
                  tax_property_cell_path(
                    tag_name: row[:tag],
                    month: month.iso8601,
                    start_year: financial_year.start_year
                  ),
                  data: { turbo_frame: "drawer" },
                  class: "text-primary hover:underline privacy-sensitive") %>
              </td>
            <% end %>
            <td class="px-3 py-3 text-sm text-right font-medium text-primary privacy-sensitive"><%= number_to_currency(row[:total]) %></td>
          </tr>
        <% end %>
        <tr class="border-t border-divider bg-container-inset font-medium">
          <td class="px-3 py-3 text-sm text-primary"><%= t("tax.property.total") %></td>
          <% property_grid.months.each do |month| %>
            <% total = monthly_expense_totals[month.iso8601] %>
            <td class="px-3 py-3 text-sm text-right text-primary privacy-sensitive"><%= number_to_currency(total) %></td>
          <% end %>
          <td class="px-3 py-3 text-sm text-right text-primary privacy-sensitive"><%= number_to_currency(property[:cost_total]) %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<div class="rounded-xl bg-container-inset space-y-1 p-1 mt-4">
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p><%= t("tax.property.rental_title") %></p>
  </div>
  <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <th class="px-3 py-3 text-left min-w-44"><%= t("tax.property.line") %></th>
          <% property_grid.months.each do |month| %>
            <th class="px-3 py-3 text-right min-w-24"><%= l(month, format: "%b %y") %></th>
          <% end %>
          <th class="px-3 py-3 text-right min-w-24"><%= t("tax.property.total") %></th>
        </tr>
      </thead>
      <tbody>
        <% property_grid.rental_rows.each do |rental| %>
          <tr class="border-b border-subdued">
            <td class="px-3 py-3 text-sm font-medium text-primary"><%= rental[:tag] %></td>
            <% property_grid.months.each do |month| %>
              <% amount = property_grid.entries_for_tag_month(rental[:tag], month).sum { |e| e.amount.abs } %>
              <td class="px-3 py-3 text-sm text-right privacy-sensitive">
                <%= link_to(amount.positive? ? number_to_currency(amount) : "—",
                  tax_property_cell_path(tag_name: rental[:tag], month: month.iso8601, start_year: financial_year.start_year),
                  data: { turbo_frame: "drawer" },
                  class: "text-primary hover:underline") %>
              </td>
            <% end %>
            <td class="px-3 py-3 text-sm text-right font-medium text-primary privacy-sensitive"><%= number_to_currency(rental[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
