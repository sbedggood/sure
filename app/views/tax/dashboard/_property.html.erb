<%# locals: (financial_year:, settings:, summary:, property_grid:) %>
<% property = summary.as_json[:property] %>

<%= render "tax/dashboard/settings_fields",
      financial_year: financial_year,
      settings: settings,
      return_section: "property",
      fields: [
        { name: "tax_fy_setting[property_allocation_percent]", label: t("tax.property.allocation"), value: settings.property_allocation_percent },
        { name: "tax_fy_setting[marginal_tax_rate_percent]", label: t("tax.property.marginal_rate"), value: settings.marginal_tax_rate_percent }
      ] %>

<div class="rounded-xl bg-container-inset space-y-1 p-1">
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p><%= t("tax.property.expenses_title") %></p>
    <span class="text-subdued">&middot;</span>
    <p><%= financial_year.label %></p>
  </div>

  <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <th class="px-3 py-3 text-left min-w-44"><%= t("tax.property.line") %></th>
          <% property_grid.months.each do |month| %>
            <th class="px-3 py-3 text-right min-w-24"><%= l(month, format: "%b %y") %></th>
          <% end %>
          <th class="px-3 py-3 text-right min-w-24"><%= t("tax.property.total") %></th>
        </tr>
      </thead>
      <tbody>
        <% property[:expense_rows].each do |row| %>
          <tr class="border-b border-subdued hover:bg-surface-hover">
            <td class="px-3 py-3 text-sm font-medium text-primary"><%= row[:label] %></td>
            <% property_grid.months.each do |month| %>
              <% amount = row[:months][month.iso8601] || 0 %>
              <td class="px-3 py-3 text-sm text-right">
                <%= link_to(number_to_currency(amount),
                  tax_property_cell_path(
                    tag_name: row[:tag],
                    month: month.iso8601,
                    start_year: financial_year.start_year
                  ),
                  data: { turbo_frame: "drawer" },
                  class: "text-primary hover:underline privacy-sensitive") %>
              </td>
            <% end %>
            <td class="px-3 py-3 text-sm text-right font-medium text-primary privacy-sensitive"><%= number_to_currency(row[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="rounded-xl bg-container-inset space-y-1 p-1 mt-4">
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p><%= t("tax.property.rental_title") %></p>
  </div>
  <div class="bg-container rounded-lg shadow-border-xs overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <th class="px-3 py-3 text-left min-w-44"><%= t("tax.property.line") %></th>
          <% property_grid.months.each do |month| %>
            <th class="px-3 py-3 text-right min-w-24"><%= l(month, format: "%b %y") %></th>
          <% end %>
          <th class="px-3 py-3 text-right min-w-24"><%= t("tax.property.total") %></th>
        </tr>
      </thead>
      <tbody>
        <% property_grid.rental_rows.each do |rental| %>
          <tr class="border-b border-subdued">
            <td class="px-3 py-3 text-sm font-medium text-primary"><%= rental[:tag] %></td>
            <% property_grid.months.each do |month| %>
              <% amount = property_grid.entries_for_tag_month(rental[:tag], month).sum { |e| e.amount.abs } %>
              <td class="px-3 py-3 text-sm text-right privacy-sensitive">
                <%= link_to(amount.positive? ? number_to_currency(amount) : "—",
                  tax_property_cell_path(tag_name: rental[:tag], month: month.iso8601, start_year: financial_year.start_year),
                  data: { turbo_frame: "drawer" },
                  class: "text-primary hover:underline") %>
              </td>
            <% end %>
            <td class="px-3 py-3 text-sm text-right font-medium text-primary privacy-sensitive"><%= number_to_currency(rental[:total]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-3 px-1">
  <div><dt class="text-secondary"><%= t("tax.property.total_costs") %></dt><dd class="text-primary font-medium privacy-sensitive"><%= number_to_currency(property[:cost_total]) %></dd></div>
  <div><dt class="text-secondary"><%= t("tax.property.allocated", percent: property[:property_allocation_percent]) %></dt><dd class="text-primary font-medium privacy-sensitive"><%= number_to_currency(property[:allocated_costs]) %></dd></div>
  <div><dt class="text-secondary"><%= t("tax.property.rent_total") %></dt><dd class="text-primary font-medium privacy-sensitive"><%= number_to_currency(property[:rental_income][:total]) %></dd></div>
  <div><dt class="text-secondary"><%= t("tax.property.difference") %></dt><dd class="text-primary font-medium privacy-sensitive"><%= number_to_currency(property[:difference]) %></dd></div>
  <div><dt class="text-secondary"><%= t("tax.property.expected_return") %></dt><dd class="text-primary font-medium privacy-sensitive"><%= number_to_currency(property[:expected_return]) %></dd></div>
</dl>
