<% data = summary.as_json[:property] %>
<%= form_with url: tax_settings_path, method: :patch, class: "mb-6 flex flex-wrap gap-4 items-end" do %>
  <%= hidden_field_tag :start_year, financial_year.start_year %>
  <%= hidden_field_tag :return_section, "property" %>
  <div>
    <label class="text-sm text-secondary"><%= t("tax.property.allocation") %></label>
    <%= number_field_tag "tax_fy_setting[property_allocation_percent]", settings.property_allocation_percent, step: 0.01, class: "rounded border border-primary bg-container px-2 py-1" %>
  </div>
  <div>
    <label class="text-sm text-secondary"><%= t("tax.property.marginal_rate") %></label>
    <%= number_field_tag "tax_fy_setting[marginal_tax_rate_percent]", settings.marginal_tax_rate_percent, step: 0.01, class: "rounded border border-primary bg-container px-2 py-1" %>
  </div>
  <%= submit_tag t("tax.property.save_settings"), class: "rounded-md bg-accent px-3 py-2 text-sm text-on-accent" %>
<% end %>

<div class="overflow-x-auto rounded-lg border border-primary">
  <table class="min-w-full text-sm">
    <thead class="bg-container-inset text-secondary">
      <tr>
        <th class="px-2 py-2 text-left">Line</th>
        <% data[:months].each do |month| %>
          <th class="px-2 py-2 text-right"><%= l(Date.iso8601(month), format: "%b %y") %></th>
        <% end %>
        <th class="px-2 py-2 text-right">Total</th>
      </tr>
    </thead>
    <tbody>
      <% data[:expense_rows].each do |row| %>
        <tr class="border-t border-primary">
          <td class="px-2 py-2 text-primary"><%= row[:label] %></td>
          <% data[:months].each do |month| %>
            <td class="px-2 py-2 text-right text-primary"><%= number_to_currency(row[:months][month] || 0) %></td>
          <% end %>
          <td class="px-2 py-2 text-right font-medium text-primary"><%= number_to_currency(row[:total]) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<dl class="mt-4 grid gap-2 text-sm sm:grid-cols-2 lg:grid-cols-3">
  <div><dt class="text-secondary">Total costs</dt><dd class="text-primary font-medium"><%= number_to_currency(data[:cost_total]) %></dd></div>
  <div><dt class="text-secondary">Allocated (<%= data[:property_allocation_percent] %>%)</dt><dd class="text-primary font-medium"><%= number_to_currency(data[:allocated_costs]) %></dd></div>
  <div><dt class="text-secondary">Rent</dt><dd class="text-primary font-medium"><%= number_to_currency(data[:rental_income][:total]) %></dd></div>
  <div><dt class="text-secondary">Difference</dt><dd class="text-primary font-medium"><%= number_to_currency(data[:difference]) %></dd></div>
  <div><dt class="text-secondary">Expected return</dt><dd class="text-primary font-medium"><%= number_to_currency(data[:expected_return]) %></dd></div>
</dl>
