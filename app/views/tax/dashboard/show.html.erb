<% content_for :title, t("tax.title") %>

<% content_for :breadcrumbs do %>
  <%= render "layouts/shared/breadcrumbs", breadcrumbs: [
        [ t("breadcrumbs.home"), root_path ],
        [ t("breadcrumbs.tax"), nil ]
      ] %>
<% end %>

<% content_for :page_header do %>
  <div class="space-y-4 mb-6">
    <header class="flex justify-between items-center text-primary font-medium gap-4">
      <div class="space-y-1 min-w-0">
        <h1 class="text-xl lg:text-3xl font-medium text-primary">
          <%= t("tax.title") %>
        </h1>
        <p class="text-sm lg:text-base text-secondary">
          <%= t("tax.subtitle", fy: @financial_year.label, start: l(@financial_year.start_on, format: :long), end: l(@financial_year.end_on, format: :long)) %>
        </p>
      </div>

      <div class="flex flex-wrap items-end justify-end gap-2 shrink-0">
        <%= form_with url: tax_dashboard_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex flex-col gap-1 min-w-[13rem]" do |f| %>
          <%= hidden_field_tag :section, @section %>
          <%= hidden_field_tag :doc_scope, @doc_scope %>
          <%= hidden_field_tag :doc_type, @doc_type %>
          <label class="text-xs text-secondary font-medium" for="tax_start_year"><%= t("tax.fy_label") %></label>
          <%= f.select :start_year,
                options_for_select(@fy_options, @financial_year.start_year),
                {},
                id: "tax_start_year",
                class: "min-w-52 w-full rounded-lg border border-secondary bg-container pl-3 pr-10 py-2 text-sm text-primary max-w-full",
                data: { auto_submit_form_target: "auto" } %>
        <% end %>
        <%= render DS::Link.new(
              text: t("tax.export"),
              icon: "download",
              variant: "outline",
              href: tax_export_path(start_year: @financial_year.start_year),
              frame: "_top"
            ) %>
      </div>
    </header>

    <%= render "tax/dashboard/fy_summary", summary: @summary, deductions: @deductions %>

    <div class="w-fit max-w-full">
      <%= render DS::SegmentedControl.new(aria_label: t("tax.sections.aria_label"), class: "bg-surface-inset overflow-x-auto no-scrollbar") do |control| %>
        <% %w[calendar property deductions documents].each do |section| %>
          <% control.with_segment(
               t("tax.sections.#{section}"),
               active: @section == section,
               href: tax_dashboard_path(start_year: @financial_year.start_year, section: section, doc_scope: @doc_scope, doc_type: @doc_type),
               class: "whitespace-nowrap px-4"
             ) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<div class="w-full space-y-4 lg:pb-6">
  <% case @section %>
  <% when "calendar" %>
    <%= render "tax/dashboard/calendar", weeks: @weeks, financial_year: @financial_year, summary: @summary %>
  <% when "property" %>
    <%= render "tax/dashboard/property", financial_year: @financial_year, settings: @settings, summary: @summary, property_grid: @property_grid %>
  <% when "deductions" %>
    <%= render "tax/dashboard/deductions", financial_year: @financial_year, settings: @settings, deductions: @deductions %>
  <% when "documents" %>
    <%= render "tax/dashboard/documents", financial_year: @financial_year, document_rows: @documents, doc_scope: @doc_scope, doc_type: @doc_type %>
  <% end %>
</div>
