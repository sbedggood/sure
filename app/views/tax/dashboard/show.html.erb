<% content_for :title, t("tax.title") %>

<div class="space-y-4 pb-6 lg:pb-12 flex flex-col">
  <header class="flex justify-between items-center gap-4 text-primary font-medium">
    <div class="min-w-0">
      <h1 class="text-xl"><%= t("tax.title") %></h1>
      <p class="text-sm text-secondary mt-0.5"><%= @financial_year.label %> · <%= l(@financial_year.start_on, format: :long) %> – <%= l(@financial_year.end_on, format: :long) %></p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <%= form_with url: tax_dashboard_path, method: :get, data: { controller: "auto-submit-form" }, class: "flex items-center" do |f| %>
        <%= hidden_field_tag :section, @section %>
        <%= render DS::Select.new(
              form: f,
              method: :start_year,
              items: @fy_options.map { |label, value| { label: label, value: value } },
              selected: @financial_year.start_year,
              label: t("tax.fy_label")
            ) %>
      <% end %>
      <%= render DS::Link.new(
            text: t("tax.export"),
            icon: "download",
            variant: "outline",
            href: tax_export_path(start_year: @financial_year.start_year),
            frame: "_top"
          ) %>
    </div>
  </header>

  <%= render DS::SegmentedControl.new(aria_label: t("tax.sections.aria_label"), class: "bg-surface-inset max-w-full overflow-x-auto") do |control| %>
    <% %w[calendar property deductions documents].each do |section| %>
      <% control.with_segment(
           t("tax.sections.#{section}"),
           active: @section == section,
           href: tax_dashboard_path(start_year: @financial_year.start_year, section: section),
           class: "whitespace-nowrap px-4"
         ) %>
    <% end %>
  <% end %>

  <% case @section %>
  <% when "calendar" %>
    <%= render "tax/dashboard/calendar", weeks: @weeks, financial_year: @financial_year, summary: @summary %>
  <% when "property" %>
    <%= render "tax/dashboard/property", financial_year: @financial_year, settings: @settings, summary: @summary, property_grid: @property_grid %>
  <% when "deductions" %>
    <%= render "tax/dashboard/deductions", financial_year: @financial_year, settings: @settings, deductions: @deductions %>
  <% when "documents" %>
    <%= render "tax/dashboard/documents", financial_year: @financial_year, document_rows: @documents, doc_scope: @doc_scope %>
  <% end %>
</div>
