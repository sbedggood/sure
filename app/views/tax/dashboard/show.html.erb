<% content_for :title, t("tax.title") %>

<div class="flex flex-col gap-6 p-4 lg:p-6">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <h1 class="text-xl font-semibold text-primary">
      <%= t("tax.title") %> — <%= @financial_year.label %>
      <span class="text-sm font-normal text-secondary">
        (<%= l(@financial_year.start_on, format: :long) %> – <%= l(@financial_year.end_on, format: :long) %>)
      </span>
    </h1>
    <div class="flex flex-wrap items-center gap-3">
      <%= form_with url: tax_dashboard_path, method: :get, class: "flex items-center gap-2" do %>
        <label class="text-sm text-secondary" for="start_year"><%= t("tax.fy_label") %></label>
        <%= select_tag :start_year,
          options_for_select(@fy_options, @financial_year.start_year),
          class: "rounded-md border border-primary bg-container px-2 py-1 text-primary",
          onchange: "this.form.submit()" %>
        <%= hidden_field_tag :section, @section %>
      <% end %>
      <span class="text-xs text-secondary">or <code>?fy=25</code></span>
      <%= link_to t("tax.export"),
        tax_export_path(start_year: @financial_year.start_year),
        class: "text-sm font-medium text-accent" %>
    </div>
  </div>

  <nav class="flex flex-wrap gap-2 border-b border-primary pb-2">
    <% %w[calendar property deductions documents documents_all].each do |section| %>
      <%= link_to t("tax.sections.#{section}"),
        tax_dashboard_path(start_year: @financial_year.start_year, section: section),
        class: class_names(
          "rounded-md px-3 py-1.5 text-sm",
          @section == section ? "bg-container-inset text-primary font-medium" : "text-secondary hover:text-primary"
        ) %>
    <% end %>
  </nav>

  <% case @section %>
  <% when "calendar" %>
    <%= render "tax/dashboard/calendar", weeks: @weeks, financial_year: @financial_year, summary: @summary %>
  <% when "property" %>
    <%= render "tax/dashboard/property", financial_year: @financial_year, settings: @settings, summary: @summary, property_grid: @property_grid %>
  <% when "deductions" %>
    <%= render "tax/dashboard/deductions", financial_year: @financial_year, settings: @settings, deductions: @deductions %>
  <% when "documents" %>
    <%= render "tax/dashboard/documents", financial_year: @financial_year, document_rows: @documents %>
  <% when "documents_all" %>
    <%= render "tax/dashboard/documents_all", financial_year: @financial_year, document_rows: @all_documents %>
  <% end %>
</div>
