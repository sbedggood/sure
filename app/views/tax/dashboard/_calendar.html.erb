<% property = summary.as_json[:calendar_totals] %>
<div class="bg-container rounded-xl shadow-border-xs p-4">
  <%= form_with url: tax_weekly_calendar_bulk_path, method: :patch do %>
    <%= hidden_field_tag :start_year, financial_year.start_year %>
    <div class="overflow-x-auto rounded-lg border border-primary">
      <table class="min-w-full text-sm">
        <thead class="bg-container-inset text-secondary">
          <tr>
            <th class="px-3 py-2 text-left"><%= t("tax.calendar.week_commencing") %></th>
            <th class="px-3 py-2 text-left"><%= t("tax.calendar.wfh_hours") %></th>
            <th class="px-3 py-2 text-left"><%= t("tax.calendar.km_driven") %></th>
            <th class="px-3 py-2 text-left"><%= t("tax.calendar.note") %></th>
          </tr>
        </thead>
        <tbody>
          <% weeks.each_with_index do |week, index| %>
            <tr class="border-t border-primary">
              <td class="px-3 py-2 text-primary">
                <%= l(week.week_commencing, format: :long) %>
                <%= hidden_field_tag "entries[#{index}][week_commencing]", week.week_commencing %>
              </td>
              <td class="px-3 py-2">
                <%= number_field_tag "entries[#{index}][wfh_hours]", week.wfh_hours, step: 0.25, min: 0, class: "w-24 rounded border border-primary bg-container px-2 py-1" %>
              </td>
              <td class="px-3 py-2">
                <%= number_field_tag "entries[#{index}][km_driven]", week.km_driven, step: 0.1, min: 0, class: "w-24 rounded border border-primary bg-container px-2 py-1" %>
              </td>
              <td class="px-3 py-2">
                <%= text_field_tag "entries[#{index}][note]", week.note, class: "w-full min-w-[12rem] rounded border border-primary bg-container px-2 py-1" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-secondary">
      <%= t("tax.calendar.totals") %>:
      <%= property[:wfh_hours_total] %> h WFH,
      <%= property[:km_total] %> km
    </p>
    <div class="mt-4">
      <%= render DS::Button.new(text: t("tax.calendar.save"), variant: "primary", type: "submit") %>
    </div>
  <% end %>
</div>
