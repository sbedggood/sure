<% property = summary.as_json[:calendar_totals] %>

<div class="rounded-xl bg-container-inset space-y-1 p-1">
  <div class="flex items-center gap-1.5 px-4 py-2 text-xs font-medium text-secondary uppercase">
    <p><%= t("tax.sections.calendar") %></p>
    <span class="text-subdued">&middot;</span>
    <p><%= financial_year.label %></p>
  </div>

  <%= styled_form_with url: tax_weekly_calendar_bulk_path, method: :patch, class: "bg-container rounded-lg shadow-border-xs" do |form| %>
    <%= hidden_field_tag :start_year, financial_year.start_year %>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-xs uppercase font-medium text-secondary border-b border-divider">
          <tr>
            <th class="px-3 py-3 text-left"><%= t("tax.calendar.week_commencing") %></th>
            <th class="px-3 py-3 text-left"><%= t("tax.calendar.wfh_hours") %></th>
            <th class="px-3 py-3 text-left"><%= t("tax.calendar.km_driven") %></th>
            <th class="px-3 py-3 text-left"><%= t("tax.calendar.note") %></th>
          </tr>
        </thead>
        <tbody>
          <% weeks.each_with_index do |week, index| %>
            <tr class="border-b border-subdued">
              <td class="px-3 py-3 text-primary">
                <%= l(week.week_commencing, format: :long) %>
                <%= hidden_field_tag "entries[#{index}][week_commencing]", week.week_commencing %>
              </td>
              <td class="px-3 py-3">
                <%= number_field_tag "entries[#{index}][wfh_hours]", week.wfh_hours, step: 0.25, min: 0, class: "w-24 rounded-md border border-primary bg-container px-2 py-1 text-sm" %>
              </td>
              <td class="px-3 py-3">
                <%= number_field_tag "entries[#{index}][km_driven]", week.km_driven, step: 0.1, min: 0, class: "w-24 rounded-md border border-primary bg-container px-2 py-1 text-sm" %>
              </td>
              <td class="px-3 py-3">
                <%= text_field_tag "entries[#{index}][note]", week.note, class: "w-full min-w-[12rem] rounded-md border border-primary bg-container px-2 py-1 text-sm" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-t border-subdued">
      <p class="text-sm text-secondary">
        <%= t("tax.calendar.totals") %>:
        <span class="text-primary font-medium"><%= property[:wfh_hours_total] %> h WFH</span>,
        <span class="text-primary font-medium"><%= property[:km_total] %> km</span>
      </p>
      <%= render DS::Button.new(text: t("tax.calendar.save"), type: "submit") %>
    </div>
  <% end %>
</div>
