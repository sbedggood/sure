<%# locals: (financial_year:, deductions:, sort:, direction:) %>
<div class="fixed bottom-[calc(5rem_+_env(safe-area-inset-bottom))] md:bottom-6 z-50 flex flex-col md:flex-row items-center gap-3 rounded-xl bg-surface-inset border-secondary shadow-border-xs px-4 text-sm text-primary md:w-auto w-[90%] py-2">
  <div class="flex items-center gap-2">
    <%= check_box_tag "tax_review_selection", 1, true,
          class: "checkbox checkbox--light",
          data: { action: "bulk-select#deselectAll" },
          aria: { label: t("tax.deductions.review_clear_selection") } %>
    <p data-bulk-select-target="selectionBarText"></p>
  </div>

  <%= form_with url: tax_review_bulk_path,
        method: :post,
        data: { turbo_stream: true },
        class: "flex flex-wrap items-center justify-end gap-2 min-w-0" do %>
    <%= hidden_field_tag :start_year, financial_year.start_year %>
    <%= hidden_field_tag :sort, sort %>
    <%= hidden_field_tag :direction, direction %>
    <%= hidden_field_tag :decision, "accept", id: nil %>
    <%= select_tag :tag_id,
          options_from_collection_for_select(
            deductions.tax_tags_for_select.reject { |t| [ Tax::TagCatalog::FOR_REVIEW_TAG, Tax::TagCatalog::DECLINED_TAG ].include?(t.name) },
            :id, :name
          ),
          include_blank: false,
          class: "min-w-[12rem] max-w-full rounded-md border border-primary bg-container px-2 py-1.5 text-sm",
          title: t("tax.deductions.accept_to_tag"),
          aria: { label: t("tax.deductions.accept_to_tag") } %>
    <%= render DS::Button.new(
          text: t("tax.deductions.approve_selected"),
          variant: "primary",
          type: "submit",
          data: { action: "bulk-select#submitBulkRequest" }
        ) %>
  <% end %>

  <%= form_with url: tax_review_bulk_path,
        method: :post,
        data: { turbo_stream: true },
        class: "shrink-0" do %>
    <%= hidden_field_tag :start_year, financial_year.start_year %>
    <%= hidden_field_tag :sort, sort %>
    <%= hidden_field_tag :direction, direction %>
    <%= hidden_field_tag :decision, "decline", id: nil %>
    <%= render DS::Button.new(
          text: t("tax.deductions.remove_selected"),
          variant: "destructive",
          type: "submit",
          data: { action: "bulk-select#submitBulkRequest" }
        ) %>
  <% end %>

  <%= render DS::Button.new(
        text: t("tax.deductions.review_clear"),
        variant: "ghost",
        type: "button",
        data: { action: "bulk-select#deselectAll" }
      ) %>
</div>
