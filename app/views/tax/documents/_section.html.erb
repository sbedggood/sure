<%# locals: (
      rows:,
      financial_year: nil,
      doc_scope: "fy",
      doc_type: "all",
      upload_start_year:,
      return_to:,
      show_scope_filter: true,
      show_fy_filter: false,
      fy_filter: nil,
      fy_options: [],
      sort: Tax::SortParams::DEFAULT_SORT,
      direction: Tax::SortParams::DEFAULT_DIRECTION,
      sort_path: :tax_dashboard_path
    ) %>
<% sort_base_params = if sort_path == :tax_documents_path
     { doc_fy: fy_filter, doc_type: doc_type }.compact
   else
     { start_year: financial_year.start_year, section: "documents", doc_scope: doc_scope, doc_type: doc_type }
   end %>
<% filtered_rows = if doc_type.present? && doc_type != "all"
     rows.select { |r| r.document_type == doc_type }
   else
     rows
   end %>

<div class="rounded-xl bg-container-inset space-y-1 p-1">
  <div class="flex flex-col gap-3 px-4 py-3 border-b border-subdued">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5 text-xs font-medium text-secondary uppercase">
        <p><%= t("tax.documents_all.title") %></p>
        <span class="text-subdued">&middot;</span>
        <p><%= filtered_rows.size %></p>
      </div>
      <%= render DS::Link.new(
            text: t("tax.documents.upload"),
            icon: "plus",
            variant: "primary",
            href: new_tax_document_path(start_year: upload_start_year, return_to: return_to),
            frame: :modal,
            class: "shrink-0"
          ) %>
    </div>

    <div class="flex flex-col gap-3 lg:flex-row lg:flex-wrap lg:items-center">
      <% if show_scope_filter && financial_year %>
        <%= render DS::SegmentedControl.new(aria_label: t("tax.documents.scope_aria"), class: "bg-surface-inset max-w-md") do |control| %>
          <% control.with_segment(
               t("tax.documents.scope_fy", fy: financial_year.label),
               active: doc_scope == "fy",
               href: tax_dashboard_path(start_year: financial_year.start_year, section: "documents", doc_scope: "fy", doc_type: doc_type, sort: sort, direction: direction)
             ) %>
          <% control.with_segment(
               t("tax.documents.scope_all"),
               active: doc_scope == "all",
               href: tax_dashboard_path(start_year: financial_year.start_year, section: "documents", doc_scope: "all", doc_type: doc_type, sort: sort, direction: direction)
             ) %>
        <% end %>
      <% end %>

      <% if show_fy_filter %>
        <%= form_with url: tax_documents_path, method: :get, data: { turbo_frame: "_top" }, class: "flex flex-col gap-1 min-w-56" do %>
          <%= hidden_field_tag :doc_type, doc_type %>
          <%= hidden_field_tag :sort, sort %>
          <%= hidden_field_tag :direction, direction %>
          <label class="text-sm text-secondary font-medium" for="doc_fy"><%= t("tax.documents_all.filter_fy") %></label>
          <%= select_tag :doc_fy,
            options_for_select([[t("tax.documents_all.all_fys"), ""]] + fy_options, fy_filter),
            id: "doc_fy",
            class: "min-w-56 w-full rounded-lg border border-secondary bg-container pl-3 pr-10 py-2 text-sm text-primary",
            onchange: "this.form.submit()" %>
        <% end %>
      <% end %>

      <%= render DS::SegmentedControl.new(aria_label: t("tax.documents.type_aria"), class: "bg-surface-inset overflow-x-auto no-scrollbar") do |control| %>
        <% type_path = ->(type) { send(sort_path, **sort_base_params, doc_type: type) } %>
        <% control.with_segment(t("tax.documents.type_all"), active: doc_type == "all", href: type_path.call("all"), class: "whitespace-nowrap px-3") %>
        <% TaxDocument::DOCUMENT_TYPES.each do |type| %>
          <% control.with_segment(
               t("tax.documents.types.#{type}", default: type.humanize),
               active: doc_type == type,
               href: type_path.call(type),
               class: "whitespace-nowrap px-3"
             ) %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "tax/documents/table",
        rows: filtered_rows,
        show_transaction_columns: true,
        upload_start_year: upload_start_year,
        return_to: return_to,
        sort: sort,
        direction: direction,
        sort_path: sort_path,
        sort_base_params: sort_base_params %>
</div>
