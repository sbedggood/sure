<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: t("tax.documents.upload_title"), subtitle: t("tax.documents.upload_description")) %>

  <% dialog.with_body do %>
    <div class="space-y-4" data-controller="drag-and-drop-import file-upload">
      <%= render "imports/drag_drop_overlay",
            title: t("tax.documents.drop_title"),
            subtitle: t("tax.documents.drop_subtitle") %>

      <%= styled_form_with url: tax_documents_path,
            multipart: true,
            class: "space-y-4",
            data: { drag_and_drop_import_target: "form", turbo_frame: "_top" } do |form| %>
        <%= hidden_field_tag :start_year, @start_year %>
        <%= hidden_field_tag :return_to, @return_to %>

        <%= form.select :document_type,
              TaxDocument::DOCUMENT_TYPES.map { |type| [ t("tax.documents.types.#{type}", default: type.humanize), type ] },
              { selected: params[:document_type], label: t("tax.documents.type") } %>

        <%= form.date_field :document_date, label: t("tax.documents.date"), value: Date.current %>

        <%= form.text_field :note, label: t("tax.calendar.note") %>

        <label class="flex flex-col items-center justify-center w-full min-h-48 border border-secondary border-dashed rounded-xl cursor-pointer"
               data-action="click->file-upload#triggerFileInput"
               data-file-upload-target="uploadArea">
          <div class="flex flex-col items-center justify-center py-8 px-4">
            <div data-file-upload-target="uploadText" class="flex flex-col items-center text-center">
              <%= icon("upload", size: "lg", class: "mb-3 text-secondary") %>
              <p class="text-sm text-primary font-medium"><%= t("tax.documents.drop_browse") %></p>
              <p class="text-xs text-secondary mt-1"><%= t("tax.documents.drop_hint") %></p>
            </div>
            <div class="flex flex-col gap-2 items-center hidden" data-file-upload-target="fileName">
              <%= icon("file-text", size: "lg", class: "text-primary") %>
              <p class="text-sm font-medium text-primary"></p>
            </div>
            <%= form.file_field :file,
                  required: true,
                  class: "hidden",
                  data: { file_upload_target: "input", drag_and_drop_import_target: "input" } %>
          </div>
        </label>

        <div class="flex justify-end gap-2 pt-2">
          <%= render DS::Button.new(text: t("ds.dialog.cancel"), variant: "secondary", type: "button", data: { action: "DS--dialog#close" }) %>
          <%= render DS::Button.new(text: t("tax.documents.upload"), type: "submit") %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
